// My keys (test fixture).
[
  {
    "context": "Workspace", // main window
    "bindings": {
      // clear the screen
      "cmd-k": "terminal::Clear",
      "cmd-w": null,
    },
  },
  // everywhere
  {
    "bindings": { "cmd-q": "app::Quit" }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-l": "terminal::Clear",
    },
  },
  // end of file note
]
