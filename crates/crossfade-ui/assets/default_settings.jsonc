// Crossfade default settings.
//
// This file is bundled into the binary and is the base layer: every key a settings
// file leaves out takes its value from here. Crossfade reads Zed's settings vocabulary
// where a key means the same thing, so keys you already have in Zed's settings.json work.
//
// Layers, lowest to highest: these defaults, your user settings.json, then a
// project-local .crossfade/settings.json. Objects merge key by key; arrays and
// scalars from a higher layer replace the lower one. A `null` unsets an optional key.
{
  // A theme name, or { "mode": "system" | "light" | "dark", "light": name, "dark": name }.
  // "system" follows the operating system appearance. Themes are Zed theme files
  // (schema v0.2.0) in the themes folder next to settings.json.
  "theme": {
    "mode": "system",
    "light": "Crossfade Light",
    "dark": "Crossfade Dark"
  },

  // Font family of the interface. null uses the system UI font.
  "ui_font_family": null,
  // Interface font size in points; values outside 10 to 24 are clamped.
  "ui_font_size": 13.0,

  // What a new conversion starts from.
  "convert": {
    // The output preset a conversion starts with. "same" keeps the input's format.
    // WAV: "same", "cd", "studio" (24-bit), "float". FLAC: "flac", "flac-cd", "flac-24".
    // AIFF: "aiff".
    "preset": "same",
    // Replace an output file that already exists instead of asking.
    "overwrite": false
  }
}
